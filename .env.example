# ==========================================
# Configurazione Plex Media Catalog
# ==========================================

# Indirizzo del server Plex sulla rete locale (porta standard 32400)
PLEX_SERVER_URL=http://192.168.1.10:32400

# Percorso di rete UNC o locale del file database di Plex
# Modifica con il nome effettivo della cartella condivisa sul tuo server Plex:
# Ad es: \\SIMONE-PLEXSRV\Databases\com.plexapp.plugins.library.db
# oppure: \\192.168.1.10\Databases\com.plexapp.plugins.library.db
PLEX_DB_PATH=\\SIMONE-PLEXSRV\Databases\com.plexapp.plugins.library.db

# Plex Online Token per l'estrazione e il ridimensionamento rapido delle nuove locandine WebP
# Reperibile su Plex Web: apri un media -> '...' -> 'Visualizza XML' -> copia il valore di 'X-Plex-Token' dall'URL
PLEX_TOKEN=
